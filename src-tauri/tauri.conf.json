{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBoom",
  "version": "0.1.0",
  "identifier": "com.openboom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenBoom",
        "width": 840,
        "height": 560,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
