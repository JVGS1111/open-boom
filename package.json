{
  "name": "open-boom",
  "version": "0.1.0",
  "private": true,
  "description": "OpenBoom - Driverless 3D spatial audio enhancer, multiband equalizer, and DSP rack for Windows",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:portable": "cargo build --release -p open-boom",
    "build:nsis": "tauri build --bundles nsis",
    "ui:dev": "npm --prefix src-ui run dev",
    "ui:build": "npm --prefix src-ui run build",
    "ui:test": "npm --prefix src-ui run test",
    "test": "npm --prefix src-ui run test",
    "release:tag": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
